# По умолчанию сеть не используется. Настройки читаются только из .env.
LLM_PROVIDER=none
OPENAI_API_KEY=
NVIDIA_API_KEY=
# Точное имя доступной chat-модели с temperature=0 и JSON mode.
OPENAI_MODEL=
NVIDIA_MODEL=
# Общий лимит первой попытки и единственной корректирующей попытки, максимум 8 с.
LLM_TIMEOUT_S=8
# LLM_SEED=42  # включать только если выбранная модель поддерживает seed
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_S=1
DATA_PATH=data/contractors.csv
EXTRA_DATA_PATH=data/contractors_extra.csv
EMBEDDINGS_PATH=data/embeddings.npy
EMBEDDINGS_IDS_PATH=data/embeddings_ids.json
DEMO_PATH=data/demo_queries.json
CACHE_DIR=cache
